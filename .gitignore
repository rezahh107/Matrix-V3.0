# Virtual environments and local package metadata
.venv/
*.egg-info/

# Python bytecode
__pycache__/
*.py[cod]

# Test, lint, type-check, and property-test caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/

# Build and distribution artifacts
build/
dist/

# Runtime-generated fonts
app/ui/fonts/*.ttf

# Local golden-run history
.golden_runs/
ci/golden_runs/

# Local UI evidence. `tools/render_ui_matrix.py` and `tools/validate_ui_dpi.py`
# regenerate these per run, and CI publishes them with upload-artifact, so the
# repository tracks the harnesses rather than their output.
artifacts/

# Runtime logs
logs/
