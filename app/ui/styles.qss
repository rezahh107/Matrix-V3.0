/* Matrix visual polish: token-driven, presentation-only Qt Style Sheet. */
QWidget {
    color: {text};
    font-size: {body_size}pt;
}

QMainWindow,
QDialog {
    background-color: {background};
}

QToolTip {
    background-color: {card};
    color: {text};
    border: 1px solid {surface_alt};
    border-radius: {radius_md}px;
    padding: {spacing_xs}px {spacing_sm}px;
}

QMenuBar {
    background-color: {card};
    border-bottom: 1px solid {surface_alt};
}

QMenuBar::item {
    background: transparent;
    border-radius: {radius_sm}px;
    padding: {spacing_xs}px {spacing_sm}px;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background-color: {surface_alt};
}

QMenu {
    background-color: {card};
    border: 1px solid {surface_alt};
    border-radius: {radius_md}px;
    padding: {spacing_xs}px;
}

QMenu::item {
    border-radius: {radius_sm}px;
    padding: {spacing_sm}px {spacing_md}px;
}

QToolBar#mainToolbar {
    background-color: {card};
    border: 1px solid {surface_alt};
    border-radius: {radius_lg}px;
    padding: {spacing_sm}px;
    spacing: {spacing_sm}px;
}

QToolBar#mainToolbar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: {radius_md}px;
    padding: 0 {spacing_md}px;
    min-height: 30px;
    color: {text};
    font-weight: 600;
}

QToolBar#mainToolbar QToolButton:hover {
    background-color: {primary_soft};
    border-color: transparent;
}

QToolBar#mainToolbar QToolButton:pressed {
    background-color: {surface_alt};
}

QToolBar#mainToolbar QToolButton:focus {
    border-color: {primary};
}

QGroupBox {
    background-color: {card};
    border: 1px solid {surface_alt};
    border-radius: {radius_lg}px;
    margin-top: {spacing_lg}px;
    padding: {spacing_md}px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    padding: 0 {spacing_sm}px;
    color: {text};
    font-weight: 700;
    font-size: {card_title_size}pt;
}

QPushButton,
QToolButton {
    background-color: {card};
    color: {text};
    border: 1px solid {border};
    border-radius: {radius_md}px;
    padding: 0 {spacing_md}px;
    min-height: 30px;
    font-weight: 600;
}

QPushButton:hover,
QToolButton:hover {
    background-color: {surface_alt};
    border-color: {primary};
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: {primary_soft};
    border-color: {primary};
}

QPushButton:focus,
QToolButton:focus {
    border-color: {primary};
}

QPushButton#btnBuildMatrix,
QPushButton#btnAllocate,
QPushButton#btnRuleEngine,
QPushButton[variant="primary"],
QToolButton[variant="primary"] {
    background-color: {primary};
    color: #ffffff;
    border-color: {primary};
    border-radius: {radius_md}px;
    min-width: 128px;
    min-height: 32px;
    padding: 0 {spacing_lg}px;
    font-weight: 700;
}

QPushButton#btnBuildMatrix:hover,
QPushButton#btnAllocate:hover,
QPushButton#btnRuleEngine:hover,
QPushButton[variant="primary"]:hover,
QToolButton[variant="primary"]:hover {
    background-color: {primary};
    border-color: {text_muted};
}

QPushButton#btnBuildMatrix:pressed,
QPushButton#btnAllocate:pressed,
QPushButton#btnRuleEngine:pressed,
QPushButton[variant="primary"]:pressed,
QToolButton[variant="primary"]:pressed {
    background-color: {primary_soft};
    color: {text};
    border-color: {primary};
}

QPushButton#btnBuildMatrix:focus,
QPushButton#btnAllocate:focus,
QPushButton#btnRuleEngine:focus,
QPushButton[variant="primary"]:focus,
QToolButton[variant="primary"]:focus {
    border-color: {text};
}

QPushButton[variant="secondary"],
QToolButton[variant="secondary"],
QPushButton#secondaryButton,
QToolButton#secondaryButton {
    background-color: {surface_alt};
    color: {text};
    border-color: {surface_alt};
}

QPushButton#secondaryButton {
    min-width: 92px;
    padding: 0 {spacing_md}px;
}

QPushButton:disabled,
QToolButton:disabled,
QPushButton#btnBuildMatrix:disabled,
QPushButton#btnAllocate:disabled,
QPushButton#btnRuleEngine:disabled,
QPushButton#secondaryButton:disabled,
QPushButton[variant="primary"]:disabled,
QToolButton[variant="primary"]:disabled,
QPushButton[variant="secondary"]:disabled,
QToolButton[variant="secondary"]:disabled {
    background-color: {surface_alt};
    color: {text_muted};
    border-color: {surface_alt};
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: {card};
    color: {text};
    border: 1px solid {border};
    border-radius: {radius_md}px;
    selection-background-color: {primary_soft};
    selection-color: {text};
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    min-height: 30px;
    padding: 0 {spacing_sm}px;
}

QTextEdit,
QPlainTextEdit {
    padding: {spacing_sm}px;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: {primary};
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: {primary};
    background-color: {card};
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: {surface_alt};
    color: {text_muted};
    border-color: {surface_alt};
}

QComboBox#themeSelector {
    min-width: 104px;
    background-color: {surface_alt};
    border-color: {surface_alt};
    font-weight: 600;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: {card};
    color: {text};
    border: 1px solid {surface_alt};
    border-radius: {radius_md}px;
    padding: {spacing_xs}px;
    selection-background-color: {primary_soft};
    selection-color: {text};
}

QCheckBox {
    spacing: {spacing_sm}px;
    color: {text};
}

QTabWidget::pane {
    background-color: {card};
    border: 1px solid {surface_alt};
    border-radius: {radius_lg}px;
    top: -1px;
}

QTabBar::tab {
    background-color: {background};
    color: {text_muted};
    border: 1px solid {surface_alt};
    border-bottom: none;
    border-top-left-radius: {radius_md}px;
    border-top-right-radius: {radius_md}px;
    padding: {spacing_sm}px {spacing_md}px;
    margin: 0 2px;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: {surface_alt};
    color: {text};
}

QTabBar::tab:selected {
    background-color: {card};
    color: {text};
    border-color: {surface_alt};
    font-weight: 700;
}

QFrame#dashboardCard,
QFrame#heroCard,
QFrame#actionsCard {
    background-color: {card};
    border: 1px solid {surface_alt};
    border-radius: {radius_lg}px;
}

QLabel#dashboardCardTitle,
QLabel#heroTitle {
    color: {text};
    font-size: {card_title_size}pt;
    font-weight: 700;
}

QLabel#dashboardCardDescription,
QLabel#dashboardChecklistItem,
QLabel#heroSubtitle,
QLabel#themeSelectorLabel,
QLabel#dashboardPolicyInfo,
QLabel#labelStageDetail,
QLabel#labelStatus,
QLabel#lastRunBadge,
QLabel#progressCaption {
    color: {text_muted};
}

QLabel#heroBadge {
    background-color: {primary_soft};
    border: 1px solid {surface_alt};
    color: {text};
    padding: {spacing_xs}px {spacing_sm}px;
    border-radius: {radius_md}px;
    font-weight: 700;
}

QLabel#lastRunBadge[empty="true"] {
    background-color: {surface_alt};
    border: 1px dashed {border};
    padding: {spacing_xs}px {spacing_sm}px;
    border-radius: {radius_md}px;
}

QProgressBar {
    background-color: {surface_alt};
    color: {text};
    border: 1px solid {surface_alt};
    border-radius: {radius_md}px;
    min-height: 12px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: {primary};
    border-radius: {radius_md}px;
}

QStatusBar {
    background-color: {card};
    border-top: 1px solid {surface_alt};
    padding: {spacing_xs}px {spacing_sm}px;
}

QLabel#languagePill,
QLabel#statusPill {
    background-color: {surface_alt};
    border: 1px solid {surface_alt};
    border-radius: {radius_md}px;
    padding: {spacing_xs}px {spacing_sm}px;
    font-weight: 700;
}

QTableView,
QTableWidget {
    background-color: {card};
    alternate-background-color: {surface_alt};
    color: {text};
    border: 1px solid {surface_alt};
    border-radius: {radius_md}px;
    gridline-color: {surface_alt};
    selection-background-color: {primary_soft};
    selection-color: {text};
}

QHeaderView::section {
    background-color: {surface_alt};
    color: {text};
    border: none;
    border-bottom: 1px solid {surface_alt};
    padding: {spacing_sm}px;
    font-weight: 700;
}

QFrame#logPanel {
    background-color: {log_background};
    border: 1px solid {log_border};
    border-radius: {radius_lg}px;
}

QPlainTextEdit#textLog {
    background-color: transparent;
    border: none;
    color: {log_foreground};
    padding: {spacing_sm}px;
}

QLabel#logPlaceholder {
    color: {text_muted};
}

QPushButton#btnClearLog,
QPushButton#btnSaveLog {
    background-color: {card};
    border: 1px solid {surface_alt};
    border-radius: {radius_md}px;
    padding: 0 {spacing_md}px;
}

QPushButton#btnClearLog:hover,
QPushButton#btnSaveLog:hover {
    background-color: {surface_alt};
}

QSplitter::handle {
    background-color: {surface_alt};
    width: 4px;
    margin: 3px 0;
}

QSplitter::handle:hover {
    background-color: {primary};
}
