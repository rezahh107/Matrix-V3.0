/* Matrix V2 — SOLID_LAYERED_PRODUCTIVITY. All normal surfaces are opaque. */
QWidget { background-color: {background}; color: {text_primary}; font-size: {body_size}pt; font-weight: 400; }
QMainWindow, QWidget#workspaceRoot, QWidget[workspaceContent="true"] { background-color: {background}; }
QToolTip { background-color: {surface_primary}; color: {text_primary}; border: 1px solid {boundary_control}; border-radius: {control_radius}px; padding: {micro}px {label_to_control}px; }
QFrame#workspaceNavigation { background-color: {surface_primary}; border: none; border-bottom: 1px solid {boundary_subtle}; }
QToolButton[navRole="primary"], QToolButton[navRole="secondary"] { background-color: transparent; color: {text_primary}; border: 2px solid transparent; border-radius: {control_radius}px; min-height: 28px; padding: 0 10px; font-size: {body_size}pt; font-weight: 400; }
QToolButton[navRole="primary"] { min-height: 32px; }
QToolButton[navRole="secondary"] { color: {text_secondary}; }
QToolButton[navRole="primary"]:hover, QToolButton[navRole="secondary"]:hover { background-color: {control_hover}; }
QToolButton[navRole="primary"]:checked, QToolButton[navRole="secondary"]:checked { background-color: {selection}; color: {text_primary}; border-bottom-color: {accent}; font-weight: 600; }
QToolButton[navRole="primary"]:focus, QToolButton[navRole="secondary"]:focus { border-color: {focus}; }
QFrame#heroCard { background-color: {surface_primary}; border: none; border-radius: {container_radius}px; }
QLabel#heroTitle { color: {text_primary}; font-size: {title_size}pt; font-weight: 600; }
QLabel#heroSubtitle { color: {text_secondary}; font-size: {body_size}pt; font-weight: 400; }
QLabel#heroBadge { background-color: {surface_secondary}; color: {text_secondary}; border: none; border-radius: {control_radius}px; padding: {micro}px {label_to_control}px; font-size: {caption_size}pt; font-weight: 600; }
QGroupBox { background-color: transparent; border: none; border-radius: 0; margin-top: {section_spacing}px; padding: {within_group}px 0 0 0; font-size: {subtitle_size}pt; font-weight: 600; color: {text_primary}; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0 {micro}px; background-color: {background}; color: {text_primary}; }
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox { background-color: {control_surface}; color: {text_primary}; border: 1px solid {boundary_control}; border-radius: {control_radius}px; min-height: 32px; padding: 0 10px; selection-background-color: {selection}; selection-color: {text_primary}; }
QTextEdit, QPlainTextEdit { padding: 6px 8px; }
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QComboBox:hover { background-color: {control_hover}; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus { border: 2px solid {focus}; background-color: {control_surface}; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QComboBox:disabled { background-color: {disabled_surface}; color: {disabled_text}; border-color: {boundary_subtle}; }
QComboBox { padding-left: 30px; padding-right: 30px; }
QComboBox QLineEdit { background-color: transparent; border: none; border-radius: 0; min-height: 0; padding: 0; }
QComboBox::drop-down { subcontrol-origin: border; subcontrol-position: top right; width: 28px; background-color: {control_surface}; border: none; border-radius: {control_radius}px; }
QComboBox::drop-down:hover { background-color: {control_hover}; }
QComboBox::drop-down:disabled { background-color: {disabled_surface}; }
QComboBox::down-arrow { image: none; width: 0; height: 0; border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid {text_secondary}; }
QComboBox::down-arrow:disabled { border-top-color: {disabled_text}; }
QComboBox QAbstractItemView { background-color: {surface_primary}; color: {text_primary}; border: 1px solid {boundary_control}; border-radius: {control_radius}px; padding: {micro}px; outline: 0; selection-background-color: {selection}; selection-color: {text_primary}; }
QPushButton, QToolButton { background-color: {control_surface}; color: {text_primary}; border: 1px solid {boundary_control}; border-radius: {control_radius}px; min-height: 32px; padding: 0 10px; font-size: {body_size}pt; font-weight: 400; }
QPushButton:hover, QToolButton:hover { background-color: {control_hover}; }
QPushButton:pressed, QToolButton:pressed { background-color: {surface_secondary}; }
QPushButton:focus, QToolButton:focus { border: 2px solid {focus}; }
QPushButton:disabled, QToolButton:disabled { background-color: {disabled_surface}; color: {disabled_text}; border-color: {boundary_subtle}; }
QPushButton[variant="primary"] { background-color: {accent}; color: #FFFFFF; border-color: {accent}; min-height: 34px; padding: 0 16px; font-weight: 600; }
QPushButton[variant="primary"]:hover { background-color: {accent_hover}; border-color: {accent_hover}; }
QPushButton[variant="primary"]:pressed { background-color: {accent_pressed}; border-color: {accent_pressed}; }
QPushButton[variant="primary"]:focus { border: 2px solid {focus}; }
QPushButton[variant="secondary"], QToolButton[variant="secondary"] { min-height: 28px; padding: 0 8px; }
QCheckBox { color: {text_primary}; spacing: {icon_to_text}px; min-height: 28px; }
/* QCheckBox::indicator intentionally remains Qt-owned per HYBRID authority. */
QProgressBar { background-color: {surface_secondary}; color: {text_primary}; border: none; border-radius: 3px; min-height: 8px; max-height: 8px; text-align: center; }
QProgressBar::chunk { background-color: {accent}; border-radius: 3px; }
QToolBar#mainToolbar { background-color: {surface_primary}; border: none; border-bottom: 1px solid {boundary_subtle}; spacing: {micro}px; padding: {micro}px {label_to_control}px; }
QToolBar#mainToolbar QToolButton { min-height: 28px; border-color: transparent; padding: 0 8px; }
QComboBox#themeSelector { min-width: 104px; }
QTabWidget::pane { background-color: {surface_primary}; border: 1px solid {boundary_subtle}; border-radius: {container_radius}px; }
QTabBar::tab { background-color: {surface_secondary}; color: {text_secondary}; border: 1px solid {boundary_subtle}; padding: 6px 10px; min-height: 28px; }
QTabBar::tab:selected { background-color: {selection}; color: {text_primary}; border-bottom: 2px solid {accent}; font-weight: 600; }
QTableView, QTableWidget { background-color: {surface_primary}; alternate-background-color: {surface_secondary}; color: {text_primary}; border: 1px solid {boundary_control}; border-radius: {control_radius}px; gridline-color: {boundary_subtle}; selection-background-color: {selection}; selection-color: {text_primary}; }
QHeaderView::section { background-color: {surface_secondary}; color: {text_primary}; border: none; border-bottom: 1px solid {boundary_control}; padding: 5px 8px; min-height: 28px; font-weight: 600; }
QFrame#pageActionFooter { background-color: {surface_primary}; border: none; border-top: 1px solid {boundary_subtle}; }
QFrame#diagnosticsPane { background-color: {diagnostic_background}; color: {diagnostic_text}; border: none; border-top: 1px solid {boundary_subtle}; }
QFrame#logPanel, QFrame#logStackHost, QPlainTextEdit#textLog { background-color: {diagnostic_background}; color: {diagnostic_text}; border: none; }
QLabel#logPlaceholder { background-color: {diagnostic_background}; color: {text_secondary}; font-size: {caption_size}pt; }
QLabel#stageBadge, QLabel#lastRunBadge, QLabel#healthStatus, QLabel#progressCaption, QLabel#statusPill, QLabel#languagePill { background-color: transparent; color: {text_secondary}; border: none; font-size: {caption_size}pt; }
QLabel#stageBadge, QLabel#statusPill[state="running"] { color: {text_primary}; font-weight: 600; }
QLabel#statusPill[state="error"], QLabel#healthStatus[health="error"] { color: {error}; font-weight: 600; }
QLabel#healthStatus[health="warning"] { color: {warning}; font-weight: 600; }
QLabel#healthStatus[health="ok"] { color: {success}; font-weight: 600; }
QLabel[databaseHealth="ok"] { color: {success}; }
QLabel[databaseHealth="warning"] { color: {warning}; }
QLabel[databaseHealth="error"] { color: {error}; }
QLabel[settingEnabled="true"], QLabel[settingEnabled="false"] { background-color: transparent; color: {text_secondary}; border: none; font-size: {caption_size}pt; }
QStatusBar { background-color: {surface_primary}; color: {text_primary}; border-top: 1px solid {boundary_subtle}; min-height: 28px; }
QStatusBar::item { border: none; }
QFrame#busyOverlay { background-color: {surface_primary}; border: 1px solid {boundary_subtle}; }
QLabel#busyOverlayLabel { background-color: transparent; color: {text_primary}; font-size: {subtitle_size}pt; font-weight: 600; }
QSplitter::handle { background-color: {boundary_subtle}; height: 4px; }
QSplitter::handle:hover { background-color: {boundary_control}; }
QFrame#dashboardCard, QFrame#databaseSection { background-color: {surface_primary}; border: none; border-radius: {container_radius}px; }
QLabel#dashboardCardTitle, QLabel#databaseSectionTitle { color: {text_primary}; font-size: {subtitle_size}pt; font-weight: 600; }
QLabel#dashboardCardDescription, QLabel#databaseSectionDescription { color: {text_secondary}; font-size: {caption_size}pt; }
QListWidget#historyRunList { background-color: {surface_primary}; color: {text_primary}; border: 1px solid {boundary_control}; border-radius: {control_radius}px; }
QTreeView, QListView { color: {text_primary}; }
/* Intentionally no QScrollBar subcontrol selectors: scrollbars remain Qt-native. */
