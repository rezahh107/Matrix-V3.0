  "invariants": [
    {
      "id": "JOIN-CORE",
      "severity": "P0",
      "description": "All joins between students and mentors must use six canonical integer join keys with consistent semantics across Import, Matrix, Core, QA and Export.",
      "responsible_modules": [
        "app/core/common/types.py",
        "app/core/common/join_keys.py",
        "app/core/canonical_frames.py",
        "app/infra/qa/alloc_join_validation.py",
        "app/core/qa/invariants.py"
      ]
    },
    {
      "id": "JOIN-01",
      "severity": "P0",
      "description": "QA and Infra must use the same join keys and wildcard rules as Core when validating allocations and matrix coverage.",
      "responsible_modules": [
        "app/infra/qa/alloc_join_validation.py",
        "app/core/qa/invariants.py",
        "app/core/common/join_keys.py"
      ]
    },
    {
      "id": "JOINKEY-SSOT",
      "severity": "P0",
      "description": "Effective Join Keys from JoinKeyResolver are the only allowed canonical join inputs; wildcard semantics are mentor-only for center/school; parity guards between allocation and audit/export are mandatory.",
      "responsible_modules": [
        "app/infra/mentors/join_key_resolver.py",
        "app/core/common/join_keys.py",
        "app/infra/qa/alloc_join_validation.py"
      ]
    },
    {
      "id": "RANK-CORE",
      "severity": "P0",
      "description": "Mentor ranking must be based only on remaining_capacity in descending order plus a deterministic tie-breaker (mentor_id natural sort). occupancy_ratio must not influence ranking.",
      "responsible_modules": [
        "app/core/common/ranking.py",
        "app/core/allocate_students.py",
        "app/core/allocation/engine.py"
      ]
    },
    {
      "id": "TRACE-CORE",
      "severity": "P0",
      "description": "Every allocation decision must be explainable via an 8-stage trace in the fixed order: type, group, gender, graduation_status, center, finance, school, capacity_gate.",
      "responsible_modules": [
        "app/core/common/types.py",
        "app/core/common/trace.py",
        "app/core/allocate_students.py"
      ]
    },
    {
      "id": "CAPACITY-01",
      "severity": "P0",
      "description": "Remaining capacity for any mentor must never become negative; capacity is enforced by a capacity gate before selection.",
      "responsible_modules": [
        "app/core/common/ranking.py",
        "app/core/allocate_students.py",
        "app/core/qa/invariants.py"
      ]
    },
    {
      "id": "R0-CAPACITY-GATE-01",
      "severity": "P0",
      "description": "Mentors with zero remaining capacity must be excluded from the candidate pool before allocation.",
      "responsible_modules": [
        "app/core/common/ranking.py",
        "app/core/allocate_students.py"
      ]
    },
    {
      "id": "SCHOOL-01",
      "severity": "P0.5",
      "description": "School join semantics must respect wildcard values and distinguish global vs constrained mentors/students as defined by Policy.",
      "responsible_modules": [
        "app/core/common/join_keys.py",
        "app/infra/qa/alloc_join_validation.py",
        "app/core/qa/invariants.py"
      ]
    },
    {
      "id": "CENTER-01",
      "severity": "P0.5",
      "description": "Center join semantics must respect wildcard values and constraints as defined by Policy.",
      "responsible_modules": [
        "app/core/common/join_keys.py",
        "app/core/qa/invariants.py"
      ]
    },
    {
      "id": "POOL-GOVERNANCE-01",
      "severity": "P0.5",
      "description": "Only mentors with allowed type/status are eligible; frozen or inactive mentors must be filtered or reported via QA.",
      "responsible_modules": [
        "app/core/allocation/mentor_pool.py",
        "app/core/qa/invariants.py"
      ]
    },
    {
