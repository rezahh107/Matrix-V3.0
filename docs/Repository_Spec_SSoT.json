      "severity": "P0",
      "description": "Core must be pure logic with deterministic outputs given the same inputs and Policy; no DB or time dependencies.",
      "responsible_modules": [
        "app/core"
      ]
    },
    {
      "id": "HISTORY-GOVERNANCE-01",
      "severity": "P1",
