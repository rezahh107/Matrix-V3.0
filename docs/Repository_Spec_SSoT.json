      "responsible_modules": [
        "app/core/canonical_frames.py",
        "app/core/build_matrix.py",
        "app/core/matrix/coverage.py"
      ]
    },
    {
      "id": "CENTER-MANAGEMENT-01",
      "severity": "P0.5",
      "description": "Center management (center manager, priority order, strict manager validation, channels) must be deterministic and Policy-driven.",
      "responsible_modules": [
        "app/core/allocation/channels.py",
        "app/core/allocation/mentor_pool.py",
        "app/core/qa/invariants.py"
      ]
    },
